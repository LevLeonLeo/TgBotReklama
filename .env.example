# Токен бота из @BotFather
BOT_TOKEN=

# ID администраторов через запятую (узнать: @userinfobot)
ADMIN_IDS=

# Контакт поддержки, например @my_support
SUPPORT_CONTACT=

# Метка рекламного поста
AD_LABEL=Реклама

# Сколько серий показывать на одной странице
PAGE_SIZE=12

# DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# По умолчанию SQLite: data/bot.db
# DATABASE_URL=sqlite+aiosqlite:///data/bot.db
